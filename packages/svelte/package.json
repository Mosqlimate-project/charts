{
  "name": "@mosqlimate/svelte",
  "version": "0.0.1",
  "description": "Svelte wrappers for @mosqlimate/charts",
  "type": "module",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@mosqlimate/charts": "*",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@mosqlimate/charts": "*",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mosqlimate-project/charts.git",
    "directory": "packages/svelte"
  }
}
