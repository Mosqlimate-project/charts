{
  "name": "@mosqlimate/react",
  "version": "0.0.1",
  "description": "React wrappers for @mosqlimate/charts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mosqlimate/charts": "*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mosqlimate/charts": "*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mosqlimate-project/charts.git",
    "directory": "packages/react"
  }
}
