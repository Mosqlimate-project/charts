{
  "name": "@mosqlimate/vue",
  "version": "1.2.1",
  "description": "Vue wrappers for @mosqlimate/charts",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mosqlimate/charts": "*",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@mosqlimate/charts": "*",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mosqlimate-project/charts.git",
    "directory": "packages/vue"
  }
}
