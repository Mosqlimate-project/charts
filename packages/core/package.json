{
  "name": "@mosqlimate/charts",
  "version": "1.0.2",
  "description": "Framework-agnostic charting SDK for Mosqlimate visualizations",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "echarts": "^6.1.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "echarts": "^5.6.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mosqlimate-project/charts",
    "directory": "packages/core"
  }
}
